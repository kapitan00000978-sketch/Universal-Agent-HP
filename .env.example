# ============================================================
#  EXTRA LLM X — Configuration
#  Copy this file to .env and fill in your keys.
# ============================================================

# ──────────────────────────────────────────────────────────────
# 1. PROVIDER — Which AI service to use (pick ONE)
# ──────────────────────────────────────────────────────────────
#   extra-llm-x  — 640+ free models via local gateway (DEFAULT)
#   groq         — ultra-fast Llama 3.3 70B (free key)
#   gemini       — Google Gemini 2.0 Flash (free key)
#   openrouter   — 20+ free models (free key)
#   cerebras     — fastest Llama inference (free key)
#   together     — open-source model hub (free tier)
#   sambanova    — fast 70B (free key)
#   deepseek     — DeepSeek Chat (paid)
#   openai       — GPT-4o (paid)
#   ollama       — local models on your machine
#   puter        — browser-based, no key needed
#   g4f          — GPT4Free, no key needed
TITAN_PROVIDER=extra-llm-x
TITAN_MODEL=extra/auto-free

# ──────────────────────────────────────────────────────────────
# 2. API KEYS — Paste your key next to the provider you use
# ──────────────────────────────────────────────────────────────

# Extra LLM X (local gateway — runs on your machine)
EXTRA_LLM_X_API_KEY=elx-master-admin-key
EXTRA_LLM_X_BASE_URL=http://localhost:3000/v1

# Free tier providers (get key free, no credit card):
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
HUGGINGFACE_API_KEY=

# Paid providers:
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Other gateways:
KIMI_API_KEY=
GLM_API_KEY=
COMPLETIONS_API_KEY=
OMNI_API_KEY=

# ──────────────────────────────────────────────────────────────
# 3. SERVER — Web dashboard settings
# ──────────────────────────────────────────────────────────────
TITAN_PORT=7860
# Server auth key (auto-generated if empty):
TITAN_API_KEY=

# ──────────────────────────────────────────────────────────────
# 4. LOCAL MODELS — Ollama / LM Studio base URLs
# ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ──────────────────────────────────────────────────────────────
# 5. TELEGRAM BOT (optional — disabled by default)
# ──────────────────────────────────────────────────────────────
TITAN_TELEGRAM_ENABLED=false
TITAN_TELEGRAM_API_ID=
TITAN_TELEGRAM_API_HASH=
TITAN_TELEGRAM_SEND_ALLOWLIST=

# ──────────────────────────────────────────────────────────────
# 6. ADVANCED (safe defaults — change only if you know why)
# ──────────────────────────────────────────────────────────────
# TITAN_MODE=fast                  # fast | deep | deep_search
# TITAN_EFFORT=auto                # auto | low | medium | high | ultra
# TITAN_MAX_ITERATIONS=25
# TITAN_STEP_CAP=48
# TITAN_CONTEXT_BUDGET_CHARS=200000
# Default shell command execution runs in a resource-limited Docker container.
# Docker must be installed; there is deliberately no automatic host fallback.
TITAN_COMMAND_SANDBOX_IMAGE=titan-agent-sandbox:local
# TITAN_FULL_ACCESS=0  # Explicit trusted-mode bypass: commands run on the host.
# Dynamic Python tool synthesis is disabled by default. Enabling it executes generated code
# with the agent process's OS privileges; subprocess tests are NOT a security sandbox.
# TITAN_DYNAMIC_TOOLS_ENABLED=false
